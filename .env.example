# Public site URL (canonical, sitemap, OG). Example: https://standoutstudio.vercel.app
NEXT_PUBLIC_SITE_URL=

# Web3Forms access key (https://web3forms.com). Safe to expose client-side.
# Create a key with destination: standout.studio.ottawa@gmail.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# PostHog (https://posthog.com). Project token from Project Settings.
# US cloud: https://us.i.posthog.com | EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
