# Public site URL (canonical, sitemap, OG). Example: https://standoutstudio.ca
NEXT_PUBLIC_SITE_URL=

# Web3Forms access key (https://web3forms.com). Safe to expose client-side.
# Create a key with destination: standout.studio.ottawa@gmail.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# PostHog (https://posthog.com). Project token from Project Settings.
# US cloud: https://us.i.posthog.com | EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------- Client area and admin area ----------
# Without the three Supabase values the areas run in demo mode (fictional data,
# emails shown in /admin/emails, simulated payments). Demo mode is refused in
# production unless PORTAL_DEMO=1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated. These addresses become admins on first sign-in. Nobody else can.
ADMIN_EMAILS=
# Shows the "Client area" link in the site header, menu and footer.
NEXT_PUBLIC_CLIENT_AREA=
# Emails (https://resend.com). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Standout Studio <bonjour@standoutstudio.ca>
# Payments (https://dashboard.stripe.com). Webhook endpoint: /api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Daily reminders (vercel.json cron). Any long random string.
CRON_SECRET=
# Demo mode only: signs demo sessions. Optional.
PORTAL_SECRET=
PORTAL_DEMO=
